// منصّة الصرف الليبية — مخطط قاعدة البيانات
// يغطي هذا الإصدار الأساس: المستخدمون، الفروع، العملات، العملاء،
// الخزينة (المراكز والحركات)، أسعار الصرف، وسجل التدقيق.
// وحدتا التداول (Trading Engine) وواتساب تُبنيان في مرحلة لاحقة فوق هذا الأساس.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// المستخدمون والصلاحيات
// ------------------------------------------------------------------

enum StaffRole {
  ADMIN // إدارة النظام والصلاحيات
  TREASURY_MANAGER // اعتماد صفقات كبيرة، تعديل أسعار يدويًا، حركات الخزينة
  TELLER // تنفيذ صفقات الصرافين وإدخال حركات الخزينة العادية
  COMPLIANCE_OFFICER // مراجعة الامتثال وتقارير مكافحة غسل الأموال
  CUSTOMER_SERVICE // إدارة ملفات العملاء والرد على الاستفسارات
}

model User {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         StaffRole
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // مصادقة متعددة العوامل (TOTP) — mfaSecretEncrypted مشفّر بـ AES-256-GCM (لا يُخزَّن نصًا صريحًا)
  // لأنه، خلافًا لكلمة المرور، يجب فكّ تشفيره لاحقًا للتحقق من الرمز؛ التجزئة أحادية الاتجاه لا تصلح هنا.
  mfaEnabled            Boolean  @default(false)
  mfaSecretEncrypted    String?
  mfaRecoveryCodeHashes String[] @default([]) // كل رمز استرداد يُستهلك مرة واحدة فقط (يُحذف من المصفوفة بعد الاستخدام)

  treasuryMovements               TreasuryMovement[]      @relation("MovementActor")
  bankMovements                   BankMovement[]          @relation("BankMovementActor")
  publishedRates                  ExchangeRate[]          @relation("RateActor")
  auditLogs                       AuditLog[]              @relation("AuditActor")
  requestedDeals                  Transaction[]           @relation("DealRequestedBy")
  approvedDeals                   Transaction[]           @relation("DealApprovedBy")
  executedDeals                   Transaction[]           @relation("DealExecutedBy")
  recordedExpenses                Expense[]               @relation("ExpenseRecordedBy")
  voidedExpenses                  Expense[]               @relation("ExpenseVoidedBy")
  clientBalanceMovementsPerformed ClientBalanceMovement[] @relation("ClientBalanceMovementActor")
  recordedRemittances             Remittance[]            @relation("RemittanceRecordedBy")
  remittanceStatusChanges         Remittance[]            @relation("RemittanceStatusActor")
  postedJournalEntries            JournalEntry[]

  @@map("users")
}

// ------------------------------------------------------------------
// الفروع والعملات
// ------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  city      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users        User[]
  positions    TreasuryPosition[]
  movements    TreasuryMovement[]
  deals        Transaction[]
  expenses     Expense[]
  remittances  Remittance[]
  journalLines JournalLine[]

  @@map("branches")
}

model Currency {
  id            String  @id @default(uuid())
  code          String  @unique // ISO 4217: LYD, USD, EUR, EGP, TND ...
  name          String
  decimalPlaces Int     @default(2)
  isActive      Boolean @default(true)

  positions        TreasuryPosition[]
  movements        TreasuryMovement[]
  bankPositions    BankPosition[]
  bankMovements    BankMovement[]
  rates            ExchangeRate[]
  balances         ClientBalance[]
  balanceMovements ClientBalanceMovement[]
  deals            Transaction[]
  expenses         Expense[]
  remittances      Remittance[]
  journalLines     JournalLine[]

  @@map("currencies")
}

// ------------------------------------------------------------------
// العملاء (KYC وحدود المخاطر)
// ------------------------------------------------------------------

enum RiskTier {
  LOW
  MEDIUM
  HIGH
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Client {
  id              String    @id @default(uuid())
  fullName        String
  clientType      String    @default("individual") // individual | company
  nationalIdOrReg String    @unique // الرقم الوطني أو رقم السجل التجاري
  phone           String    @unique // رقم واتساب الأساسي للعميل
  address         String?
  kycStatus       KycStatus @default(PENDING)
  riskTier        RiskTier  @default(MEDIUM)

  // الحدود مُعبَّر عنها بما يعادلها بالدولار الأمريكي لتبسيط المقارنة عبر العملات —
  // اختيارية: لم تعد تُطلَب عند تسجيل العميل (لا فحص حدّي على الصفقات أصلًا بعد
  // إلغائه صراحةً)، وتبقى null حتى يضبطها مسؤول لاحقًا يدويًا عبر تحديث الحدود
  // (ClientsService.updateLimits) إن أراد الاحتفاظ برقم مرجعي فقط.
  dailyLimitUsd  Decimal? @db.Decimal(18, 2)
  creditLimitUsd Decimal? @db.Decimal(18, 2)

  whatsappOptIn Boolean  @default(false) // موافقة صريحة على تحديثات واتساب الجماعية
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  balances         ClientBalance[]
  balanceMovements ClientBalanceMovement[]
  deals            Transaction[]
  whatsappMessages WhatsAppMessage[]
  remittances      Remittance[]

  @@index([riskTier])
  @@map("clients")
}

// رصيد وديعة العميل لدى الشركة (Custody) — منفصل تمامًا عن صفقات الصرف الفورية
// عند الشباك. يُحدَّث فقط عبر applyClientBalanceMovement ضمن معاملة واحدة مع
// صف ClientBalanceMovement المقابل — لا تحديث مباشر على balance من أي مكان آخر.
model ClientBalance {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])
  balance    Decimal  @default(0) @db.Decimal(18, 2) // قد يكون سالبًا (عميل مدين) — لا قيد يمنع ذلك عمدًا
  updatedAt  DateTime @updatedAt

  @@unique([clientId, currencyId])
  @@map("client_balances")
}

enum ClientBalanceMovementType {
  DEPOSIT // إيداع يُضاف لرصيد وديعة العميل لدى الشركة
  WITHDRAWAL // سحب من رصيد وديعة العميل
  ADJUSTMENT_INCREASE // تصحيح يدوي بالزيادة (خطأ سابق، تسوية إدارية...)
  ADJUSTMENT_DECREASE // تصحيح يدوي بالنقصان
}

// دفتر تراكمي (Append-only) لكل حركة على رصيد وديعة عميل — لا تحديث ولا حذف
// على مستوى التطبيق، تمامًا كسجل TreasuryMovement. treasuryMovementId يربط
// الحركة بحركة الخزينة الفعلية إن كان الإيداع/السحب نقديًا حقيقيًا من شباك فرع
// (حقل نصي بسيط بلا علاقة Prisma، على غرار Expense.treasuryMovementId).
model ClientBalanceMovement {
  id                 String                    @id @default(uuid())
  clientId           String
  client             Client                    @relation(fields: [clientId], references: [id])
  currencyId         String
  currency           Currency                  @relation(fields: [currencyId], references: [id])
  type               ClientBalanceMovementType
  amount             Decimal                   @db.Decimal(18, 2) // دومًا قيمة موجبة؛ الاتجاه يحدده type
  balanceAfter       Decimal                   @db.Decimal(18, 2) // قد يكون سالبًا (عميل مدين)
  reason             String
  performedById      String
  performedBy        User                      @relation("ClientBalanceMovementActor", fields: [performedById], references: [id])
  treasuryMovementId String?
  createdAt          DateTime                  @default(now())

  // إشعار واتساب برصيد العميل بعد هذه الحركة (WhatsAppService.sendClientBalanceUpdate)
  // — صف واحد عادةً (نجح أو فشل)؛ غيابه يعني حركة سابقة على إضافة هذه الميزة.
  whatsappMessages WhatsAppMessage[]

  @@index([clientId, currencyId, createdAt])
  @@map("client_balance_movements")
}

// ------------------------------------------------------------------
// الخزينة: المراكز الحالية وسجل الحركات (دفتر غير قابل للتعديل)
// ------------------------------------------------------------------

model TreasuryPosition {
  id           String   @id @default(uuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  currencyId   String
  currency     Currency @relation(fields: [currencyId], references: [id])
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  minThreshold Decimal? @db.Decimal(18, 2) // حد أدنى تحذيري — اختياري، بلا حد أدنى إن تُرك فارغًا
  maxExposure  Decimal? @db.Decimal(18, 2) // سقف التعرّض المسموح به — اختياري، بلا سقف إن تُرك فارغًا
  updatedAt    DateTime @updatedAt

  @@unique([branchId, currencyId])
  @@map("treasury_positions")
}

enum MovementType {
  DEPOSIT // إيداع في الخزينة (تغذية)
  WITHDRAWAL // سحب من الخزينة
  TRANSFER_IN // تحويل وارد من فرع/خزينة أخرى
  TRANSFER_OUT // تحويل صادر إلى فرع/خزينة أخرى
  ADJUSTMENT_INCREASE // تسوية جرد بالزيادة
  ADJUSTMENT_DECREASE // تسوية جرد بالنقصان
  TRADE_BUY // طرف العملة الأجنبية: زيادتها الناتجة عن شرائها من عميل (تنفيذ صفقة)
  TRADE_SELL // طرف العملة الأجنبية: نقصانها الناتج عن بيعها لعميل (تنفيذ صفقة)
  // الطرف المقابل بالدينار الليبي لكل من TRADE_BUY/TRADE_SELL — التسوية النقدية
  // الفعلية مع العميل بسعر الصفقة المقفل (lydEquivalent)، مسجَّلة كحركة مستقلة
  // مرتبطة بنفس dealId ضمن معاملة التنفيذ نفسها (DealsService.execute).
  TRADE_BUY_SETTLEMENT // نقصان الدينار الليبي: الشركة تدفعه نقدًا للعميل مقابل شراء عملته
  TRADE_SELL_SETTLEMENT // زيادة الدينار الليبي: الشركة تحصّله نقدًا من العميل مقابل بيعه عملة له
}

// دفتر حركات الخزينة — سجل تراكمي فقط (Append-only)، لا تُنفَّذ عليه عمليات تعديل أو حذف
// من طبقة التطبيق؛ كل حركة تحمل الرصيد بعدها مباشرة لتتيح تدقيقًا مستقلًا عن الجدول الحالي.
model TreasuryMovement {
  id            String       @id @default(uuid())
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  currencyId    String
  currency      Currency     @relation(fields: [currencyId], references: [id])
  type          MovementType
  amount        Decimal      @db.Decimal(18, 2) // دومًا قيمة موجبة؛ الاتجاه يحدده type
  balanceAfter  Decimal      @db.Decimal(18, 2)
  reason        String
  performedById String
  performedBy   User         @relation("MovementActor", fields: [performedById], references: [id])
  dealId        String? // إن كانت الحركة ناتجة عن تنفيذ صفقة تداول (TRADE_BUY/TRADE_SELL)
  deal          Transaction? @relation(fields: [dealId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([branchId, currencyId, createdAt])
  @@map("treasury_movements")
}

// ------------------------------------------------------------------
// المصارف: حسابات بنكية للشركة، مستقلة مركزيًا (غير مرتبطة بفرع بعينه) —
// بنفس آلية خزينة الفروع تمامًا (مركز رصيد لكل عملة + دفتر حركات تراكمي)،
// كيان مواز لا فرق جوهري به عن Branch/TreasuryPosition/TreasuryMovement
// سوى أنه لا يمثّل موقعًا فعليًا للنقد بل حسابًا مصرفيًا. التحويل بين خزينة
// فرع وحساب مصرفي يُسجَّل كحركتين مستقلتين تمامًا (TRANSFER_OUT على الفرع
// ثم TRANSFER_IN على المصرف، أو العكس) — لا ربط بنيوي بينهما في قاعدة
// البيانات، فقط بنص السبب يدويًا؛ تمامًا كالتحويل بين فرعين حاليًا.
// ------------------------------------------------------------------

model Bank {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String // اسم المصرف والحساب معًا، مثال: "مصرف الجمهورية — الحساب الرئيسي"
  accountNumber String? // رقم الحساب المصرفي — اختياري، مرجعي فقط
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  positions BankPosition[]
  movements BankMovement[]

  @@map("banks")
}

model BankPosition {
  id           String   @id @default(uuid())
  bankId       String
  bank         Bank     @relation(fields: [bankId], references: [id])
  currencyId   String
  currency     Currency @relation(fields: [currencyId], references: [id])
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  minThreshold Decimal? @db.Decimal(18, 2) // حد أدنى تحذيري — اختياري، بلا حد أدنى إن تُرك فارغًا
  maxExposure  Decimal? @db.Decimal(18, 2) // سقف التعرّض المسموح به — اختياري، بلا سقف إن تُرك فارغًا
  updatedAt    DateTime @updatedAt

  @@unique([bankId, currencyId])
  @@map("bank_positions")
}

// دفتر حركات المصرف — سجل تراكمي فقط (Append-only)، بلا تعديل أو حذف من
// طبقة التطبيق، تمامًا كـ TreasuryMovement. النوع مقيَّد بمجموعة فرعية من
// MovementType على مستوى DTO (لا القاعدة): DEPOSIT/WITHDRAWAL/TRANSFER_IN/
// TRANSFER_OUT/ADJUSTMENT_INCREASE/ADJUSTMENT_DECREASE فقط — TRADE_BUY/SELL
// وتسويتهما خاصة بصفقات الصرف على خزينة فرع، لا معنى لها على حساب مصرفي.
model BankMovement {
  id            String       @id @default(uuid())
  bankId        String
  bank          Bank         @relation(fields: [bankId], references: [id])
  currencyId    String
  currency      Currency     @relation(fields: [currencyId], references: [id])
  type          MovementType
  amount        Decimal      @db.Decimal(18, 2) // دومًا قيمة موجبة؛ الاتجاه يحدده type
  balanceAfter  Decimal      @db.Decimal(18, 2)
  reason        String
  performedById String
  performedBy   User         @relation("BankMovementActor", fields: [performedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([bankId, currencyId, createdAt])
  @@map("bank_movements")
}

// ------------------------------------------------------------------
// أسعار الصرف — كل صف قيمة تاريخية غير قابلة للتعديل (Append-only)
// آخر صف لكل عملة هو السعر "الحالي" المعروض.
// ------------------------------------------------------------------

enum RateSource {
  PROVIDER // مصدر بيانات آلي (بنك/مزوّد تسعير)
  AGGREGATED // متوسط مرجّح من عدة مصادر
  MANUAL // إدخال يدوي عادي ضمن الانحراف المسموح
  OVERRIDE // تجاوز يدوي موثّق تجاوز فحص الانحراف التلقائي
}

model ExchangeRate {
  id             String     @id @default(uuid())
  currencyId     String
  currency       Currency   @relation(fields: [currencyId], references: [id])
  rate           Decimal    @db.Decimal(18, 6) // سعر الصرف مقابل الدينار الليبي
  source         RateSource
  isOverride     Boolean    @default(false)
  overrideReason String?
  publishedById  String
  publishedBy    User       @relation("RateActor", fields: [publishedById], references: [id])
  createdAt      DateTime   @default(now())

  deals Transaction[] @relation("DealSourceRate")

  @@index([currencyId, createdAt])
  @@map("exchange_rates")
}

// ------------------------------------------------------------------
// محرك التداول: صفقات العملاء من الطلب حتى التسوية
// ------------------------------------------------------------------

enum DealDirection {
  BUY // الشركة تشتري العملة الأجنبية من العميل (تدخل الخزينة)
  SELL // الشركة تبيع العملة الأجنبية للعميل (تخرج من الخزينة)
}

enum DealCustomerType {
  INTERNAL // عميل مسجَّل مسبقًا في النظام (Client) — clientId إلزامي
  EXTERNAL // زبون عابر غير مسجَّل — بياناته تُدخَل يدويًا لهذه الصفقة فقط
}

enum DealStatus {
  PENDING_APPROVAL // بانتظار موافقة ضابط ثانٍ (تتجاوز حد الموافقة المزدوجة)
  APPROVED // معتمدة (تلقائيًا إن كانت ضمن الحد، أو بعد موافقة ضابط ثانٍ) وجاهزة للتنفيذ
  REJECTED // رفضها المعتمد
  EXPIRED // انتهت مهلة قفل السعر قبل التنفيذ أو الاعتماد
  EXECUTED // نُفِّذت وأثّرت على رصيد الخزينة
  CANCELLED // ألغاها منشئها قبل الاعتماد أو التنفيذ
}

// صفقة تداول: من طلب العميل إلى قفل السعر فالموافقة المزدوجة (عند الحاجة) فالتنفيذ.
// كل تحوّل حالة يُسجَّل في AuditLog؛ التنفيذ الفعلي يُنشئ TreasuryMovement مرتبطًا بالصفقة.
model Transaction {
  id String @id @default(uuid())

  // رقم معاملة تسلسلي قابل للقراءة — مستقل عن id (UUID داخلي)، للعرض والمتابعة
  // في الواجهة والمراسلات الداخلية فقط؛ لا يُستخدم في أي مسار API (التنفيذ/
  // الاعتماد/الإلغاء تبقى كلها بـ id). يولَّده تسلسل قاعدة بيانات منفصل
  // (transactions_dealNumber_seq)، لا Prisma — القيمة دومًا جاهزة عند الإنشاء.
  dealNumber Int @unique @default(autoincrement())

  // تصنيف الطرف المتعامل — على غرار Remittance.customerType بالضبط: عميل
  // داخلي مسجَّل (clientId إلزامي)، أو زبون خارجي عابر. externalCustomerName/
  // externalCustomerPhone أُبقيا في المخطط للحفاظ على بيانات صفقات تاريخية
  // فقط — DealsService.create لم يعد يقبلهما أو يطلبهما إطلاقًا (أُلغي إدخال
  // اسم وهاتف الزبون الخارجي صراحةً)؛ كل صفقة EXTERNAL جديدة تُخزَّن بهما
  // null، وتُعرَض بتسمية عامة "زبون خارجي" بدل اسم فعلي (انظر dealPartyName).
  customerType          DealCustomerType @default(INTERNAL)
  clientId              String?
  client                Client?          @relation(fields: [clientId], references: [id])
  externalCustomerName  String?
  externalCustomerPhone String?

  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  direction DealDirection

  amount              Decimal @db.Decimal(18, 2) // كمية العملة الأجنبية محل الصفقة
  lockedRate          Decimal @db.Decimal(18, 6) // سعر الصفقة (بيع/شراء) — يُدخله الموظف يدويًا عند الإنشاء، لا يُشتَق تلقائيًا من أي سعر منشور
  lydEquivalent       Decimal @db.Decimal(18, 2) // amount × lockedRate
  amountUsdEquivalent Decimal @db.Decimal(18, 2) // بما يعادله بالدولار — لغرض العرض والتقارير المقارنة عبر العملات فقط، لا لأي فحص حدّ

  // سعر السوق الموازي المرجعي وقت الصفقة (يُدخله الموظف يدويًا، كسعر الصفقة
  // تمامًا) — أساس احتساب هامش الربح/الخسارة الفعلي: عند الشراء (BUY) الربح إن
  // كان سعر السوق أعلى من سعر الصفقة، وعند البيع (SELL) الربح إن كان سعر
  // الصفقة أعلى من سعر السوق (انظر computeDealProfitLyd). يُقفل الاثنان معًا
  // عند الإنشاء ولا يُعاد حسابهما لاحقًا. profitLyd محسوبة ومخزَّنة عند الإنشاء
  // (DealsService.create)، وتُرحَّل محاسبيًا لقائمة الدخل تلقائيًا عند التنفيذ
  // الفعلي (DealsService.execute)، لا عند مجرد الإنشاء — فصفقة أُلغيت أو انتهت
  // مهلتها لا تمسّ القوائم المالية إطلاقًا.
  parallelMarketRate Decimal @db.Decimal(18, 6)
  profitLyd          Decimal @db.Decimal(18, 2)

  sourceRateId String // آخر سعر صرف رسمي منشور وقت الإنشاء — مرجعي/للتدقيق فقط الآن، لا يُستخدم لاشتقاق lockedRate (صار يدويًا بالكامل)
  sourceRate   ExchangeRate @relation("DealSourceRate", fields: [sourceRateId], references: [id])

  // كل صفقة جديدة تُنشأ مباشرة بحالة APPROVED (لا فحص حدود عميل ولا موافقة مزدوجة
  // بعد الآن — أُلغيت الخاصيتان صراحةً). PENDING_APPROVAL يبقى في التعداد وتبقى
  // مساراته (approve/reject) تعمل فقط لتسوية أي صفقة تاريخية سابقة كانت قد دخلت
  // هذه الحالة قبل الإلغاء؛ لا صفقة جديدة تدخلها بعد اليوم.
  status DealStatus @default(APPROVED)

  lockExpiresAt DateTime

  requestedById String
  requestedBy   User   @relation("DealRequestedBy", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("DealApprovedBy", fields: [approvedById], references: [id])

  rejectedReason String?

  executedById String?
  executedBy   User?     @relation("DealExecutedBy", fields: [executedById], references: [id])
  executedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements        TreasuryMovement[]
  whatsappMessages WhatsAppMessage[]

  @@index([clientId, createdAt])
  @@index([branchId, status])
  @@map("transactions")
}

// ------------------------------------------------------------------
// بوابة واتساب — سجل كل رسالة واردة وصادرة (WhatsApp Business Cloud API)
// لا يوجد نموذج منفصل لـ"القوالب": قوالب الرسائل تُعتمد وتُدار داخل Meta
// Business Manager نفسها، لا داخل قاعدة بياناتنا؛ سجل الأسماء المعتمدة يُحفظ
// في الكود (انظر src/whatsapp/templates.ts) لأنه لا معنى لتخزينها بمعزل عن
// اعتماد Meta الفعلي لها.
// ------------------------------------------------------------------

enum MessageDirection {
  INBOUND // من العميل إلى الشركة
  OUTBOUND // من الشركة إلى العميل
}

enum MessageKind {
  FREE_TEXT // رد حر داخل نافذة خدمة العميل (24 ساعة من آخر رسالة واردة)
  TEMPLATE // قالب معتمد مسبقًا — إلزامي لأي رسالة تبدأها الشركة
}

enum MessageIntent {
  RATE_INQUIRY // استفسار سعر فوري
  HUMAN_HANDOFF // تحويل لموظف بشري
  OTHER
}

enum MessageStatus {
  RECEIVED // رسالة واردة سُجّلت
  SENT // أُرسلت بنجاح عبر Meta Cloud API
  FAILED // فشل الإرسال (يُحفظ السبب في errorMessage)
}

model WhatsAppMessage {
  id                             String                 @id @default(uuid())
  direction                      MessageDirection
  kind                           MessageKind
  intent                         MessageIntent? // للرسائل الواردة فقط
  waPhoneNumber                  String // رقم واتساب بالصيغة الدولية
  clientId                       String?
  client                         Client?                @relation(fields: [clientId], references: [id])
  templateName                   String?
  body                           String // النص الفعلي المُرسَل أو المُستقبَل — للتدقيق والعرض
  status                         MessageStatus
  errorMessage                   String?
  providerMessageId              String? // معرّف الرسالة من Meta، إن توفّر
  relatedDealId                  String?
  relatedDeal                    Transaction?           @relation(fields: [relatedDealId], references: [id])
  // إشعار رصيد تلقائي مرتبط بحركة على رصيد وديعة عميل (إيداع/سحب/تصحيح) —
  // انظر WhatsAppService.sendClientBalanceUpdate.
  relatedClientBalanceMovementId String?
  relatedClientBalanceMovement   ClientBalanceMovement? @relation(fields: [relatedClientBalanceMovementId], references: [id])
  // إشعار تلقائي بسحب حوالة — انظر WhatsAppService.sendRemittanceWithdrawn.
  relatedRemittanceId            String?
  relatedRemittance              Remittance?            @relation(fields: [relatedRemittanceId], references: [id])
  createdAt                      DateTime               @default(now())

  @@index([clientId, createdAt])
  @@index([waPhoneNumber, createdAt])
  @@map("whatsapp_messages")
}

// ------------------------------------------------------------------
// سجل التدقيق — تراكمي فقط، يغطي كل العمليات الحساسة في كل الوحدات
// ------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  entityType String // مثال: "Client", "ExchangeRate", "TreasuryMovement"
  entityId   String
  action     String // مثال: "CREATE", "UPDATE_LIMITS", "PUBLISH_RATE_OVERRIDE"
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------
// المصاريف التشغيلية للشركة (رواتب، إيجار، خدمات...) — منفصلة تمامًا
// عن حركات خزينة العملاء (TreasuryMovement)؛ لا تؤثر على أرصدة الخزينة.
// ------------------------------------------------------------------

enum ExpenseCategory {
  SALARIES // رواتب وأجور
  RENT // إيجارات
  UTILITIES // كهرباء، ماء، اتصالات وإنترنت
  MAINTENANCE // صيانة ومستلزمات تشغيل
  OFFICE_SUPPLIES // مستلزمات مكتبية
  MARKETING // تسويق وإعلان
  PROFESSIONAL_FEES // أتعاب مهنية (محاماة، محاسبة، استشارات)
  TAXES_GOVERNMENT // رسوم ومستحقات حكومية
  TRAVEL // سفر وتنقلات
  OTHER // أخرى
}

// سجل تراكمي — لا حذف فعلي لأي مصروف؛ تصحيح الخطأ يكون بإلغائه (isVoided)
// مع سبب موثّق، فيبقى أثره ظاهرًا في السجل والتدقيق.
model Expense {
  id          String          @id @default(uuid())
  branchId    String? // فارغ للمصاريف المركزية غير المرتبطة بفرع بعينه
  branch      Branch?         @relation(fields: [branchId], references: [id])
  currencyId  String
  currency    Currency        @relation(fields: [currencyId], references: [id])
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(18, 2)
  description String
  expenseDate DateTime        @default(now())

  recordedById String
  recordedBy   User   @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])

  // إن كان صحيحًا، خُصم المبلغ فورًا نقدًا من رصيد خزينة الفرع عند التسجيل (سحب تلقائي مرتبط)،
  // ويُعاد إيداعه تلقائيًا عند الإلغاء. المصروف بلا هذا العلم لا يمسّ الخزينة إطلاقًا (مثلًا
  // مصروف مسدَّد من حساب بنكي، لا نقدًا من الشباك).
  paidFromTreasury   Boolean @default(false)
  treasuryMovementId String? // معرّف حركة الخزينة (سحب) الناتجة — بلا علاقة Prisma مباشرة تفاديًا لدورة علاقات ثنائية الاتجاه

  isVoided   Boolean   @default(false)
  voidReason String?
  voidedById String?
  voidedBy   User?     @relation("ExpenseVoidedBy", fields: [voidedById], references: [id])
  voidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, expenseDate])
  @@index([branchId, expenseDate])
  @@map("expenses")
}

// ------------------------------------------------------------------
// حوالات تركيا↔ليبيا (عبر شبكة وسترن يونيون/موني جرام كوكيل) — تدفق ثابت
// واحد بالشركة: استلام في تركيا ثم تسليم في ليبيا؛ لا اتجاه يُختار يدويًا
// بعد الآن. الربح الأساسي بالدولار = turkeyReceiptAmount - libyaDeliveryAmount
// (محسوب تلقائيًا)، مع بدل تركيا اختياري يدوي منفصل بالدينار الليبي
// (turkeyAllowanceLyd). وحدة مستقلة تمامًا عن حسابات وديعة العملاء
// (ClientBalance) وحركات خزينة الفروع (TreasuryMovement). لا حذف فعلي لأي
// حوالة — دورة حياة status ثلاثية (PENDING → WITHDRAWN أو REJECTED) تحل
// محل isVoided القديم؛ الهامش يُحسب ويُخزَّن عند التسجيل (PENDING) لكن لا
// يُرحَّل محاسبيًا إلا عند السحب الفعلي (WITHDRAWN) — تمامًا كصفقات الصرف
// (DealsService: profitLyd يُحسب عند الإنشاء، يُرحَّل عند التنفيذ فقط).
// ------------------------------------------------------------------

enum RemittanceProvider {
  WESTERN_UNION // وسترن يونيون
  MONEYGRAM // موني جرام
}

// أُبقي هذا التعداد للحوالات التاريخية السابقة على إلغاء خانة الاتجاه فقط —
// Remittance.direction صار عمودًا اختياريًا لا يُطلَب ولا يُعرَض لأي حوالة
// جديدة (كل حوالة تتبع نفس التدفق الثابت: استلام في تركيا ← تسليم في ليبيا).
enum RemittanceDirection {
  SEND // حوالة صادرة — العميل يرسل مبلغًا عبر الشركة كوكيل
  RECEIVE // حوالة واردة — العميل يستلم مبلغًا مرسلًا إليه عبر الشركة
}

enum RemittanceCustomerType {
  INTERNAL // عميل مسجَّل مسبقًا في النظام (Client) — clientId إلزامي
  EXTERNAL // زبون عابر غير مسجَّل — بياناته تُدخَل يدويًا لهذه الحوالة فقط
}

enum RemittanceStatus {
  PENDING // قيد التعديل — سُجّلت للتو، لم تُسحَب أو تُرفض بعد؛ لا أثر محاسبي بعد
  WITHDRAWN // تم السحب — استلمها المستفيد فعليًا؛ عندها فقط يُرحَّل الهامش محاسبيًا
  REJECTED // تم الرفض — نهاية ملغاة، بلا أي ترحيل محاسبي إطلاقًا
}

// سجل تراكمي — لا حذف فعلي لأي حوالة؛ تصحيح خطأ التسجيل يكون برفضها
// (status = REJECTED) مع سبب موثّق، فيبقى أثرها ظاهرًا في السجل والتدقيق.
model Remittance {
  id           String                 @id @default(uuid())
  provider     RemittanceProvider
  direction    RemittanceDirection? // تاريخي فقط — انظر تعليق التعداد أعلاه
  customerType RemittanceCustomerType

  // كل حوالة جديدة مرتبطة بعميل حقيقي (Client) — عُثر عليه بهاتفه أو سُجِّل
  // تلقائيًا عند الإنشاء (RemittancesService.create) لدعم أكثر من حوالة لنفس
  // الزبون في يوم واحد (قيد التعديل + سابقة مسحوبة مثلًا). customerType يبقى
  // INTERNAL دومًا لأي حوالة جديدة؛ externalCustomerName/externalCustomerPhone
  // أُبقيا نسخة تاريخية فقط لحوالات زبائن خارجيين سابقة على هذا التغيير.
  clientId              String?
  client                Client? @relation(fields: [clientId], references: [id])
  externalCustomerName  String?
  externalCustomerPhone String?

  // الطرف الآخر/القيمة الأساسية — أُلغي إدخالهما صراحةً؛ أُبقيا اختياريَّين في
  // المخطط لحفظ بيانات الحوالات التاريخية فقط.
  counterpartyName String?
  referenceNumber  String // MTCN لوسترن يونيون / الرقم المرجعي لموني جرام
  countryCode      String? // بلد الطرف الآخر — تاريخي فقط، أُلغي إدخاله أيضًا

  principalAmount Decimal? @db.Decimal(18, 2) // تاريخي فقط — أُلغي إدخاله صراحةً
  currencyId      String // دومًا معرّف عملة USD — لا يُختار يدويًا (الحوالة كلها بالدولار فقط)
  currency        Currency @relation(fields: [currencyId], references: [id])

  // اقتصاديات الحوالة الفعلية للشركة — كلاهما بالدولار دومًا (نفس عملة principalAmount):
  turkeyReceiptAmount Decimal  @db.Decimal(18, 2) // سعر الاستلام في تركيا (ما يصل الشركة فعليًا هناك)
  libyaDeliveryAmount Decimal  @db.Decimal(18, 2) // سعر التسليم في ليبيا (ما تدفعه الشركة فعليًا هنا)
  profit              Decimal  @db.Decimal(18, 2) // = turkeyReceiptAmount - libyaDeliveryAmount بالدولار، تلقائي عند التسجيل
  turkeyAllowanceLyd  Decimal? @db.Decimal(18, 2) // "بدل تركيا" — هامش إضافي يدوي اختياري بالدينار الليبي فقط، منفصل تمامًا عن profit (عملة مختلفة)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  status            RemittanceStatus @default(PENDING)
  statusReason      String? // سبب الرفض تحديدًا — إلزامي عمليًا عند REJECTED (تتحقق منه الخدمة، لا القاعدة)
  statusChangedById String?
  statusChangedBy   User?            @relation("RemittanceStatusActor", fields: [statusChangedById], references: [id])
  statusChangedAt   DateTime?

  recordedById String
  recordedBy   User   @relation("RemittanceRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whatsappMessages WhatsAppMessage[]

  @@index([provider, status, createdAt])
  @@index([branchId, createdAt])
  @@map("remittances")
}

// ------------------------------------------------------------------
// المحاسبة العامة (دفتر الأستاذ ذو القيد المزدوج) — القوائم المالية
// (المركز المالي والدخل) تُشتَق حصرًا من هذا الدفتر عبر تجميع (aggregate)
// قراءة فقط، لا من جمع أرقام متفرقة من وحدات أخرى؛ توازن معادلة
// (الأصول = الخصوم + حقوق الملكية) مضمون بنيويًا طالما كل قيد متوازن
// (مجموع المدين = مجموع الدائن ضمن كل عملة على حدة) — لا حاجة لأي "تصحيح"
// لاحق لإجبار التوازن. القيود تُرحَّل تلقائيًا من: المصاريف، حركات الخزينة
// (العادية والمرتبطة برصيد عميل)، هامش الحوالات، وتعديلات أرصدة العملاء —
// وتُدخَل يدويًا لما لا يمكن ترحيله تلقائيًا بثقة (رأس المال، الأصول الثابتة
// واستهلاكها، القروض، الضريبة، وهامش صفقات الصرف الذي لا يُسجَّل تلقائيًا
// بعد لعدم وجود حقل تكلفة/هامش على Transaction حاليًا).
// ------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountClass {
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum DebitCredit {
  DEBIT
  CREDIT
}

// شجرة الحسابات — ثابتة الرمز (code) وتُزرَع مرة واحدة (seed) عبر
// AccountingService.ensureChartOfAccounts()، وهي عملية idempotent (upsert
// بالرمز) تُستدعى تلقائيًا عند إقلاع التطبيق. isSystem=true يمنع حذف الحساب
// من أي واجهة إدارية مستقبلية (لا يوجد حذف حسابات في هذا الإصدار أصلًا).
model Account {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  type          AccountType
  class         AccountClass
  normalBalance DebitCredit // الاتجاه الذي تزيد به قيمة الحساب طبيعيًا
  isSystem      Boolean      @default(true)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  lines JournalLine[]

  @@map("accounts")
}

// قيد يومية — رأس القيد فقط؛ التفاصيل في JournalLine. دفتر تراكمي صرف: لا
// تعديل ولا حذف لأي قيد مُرحَّل، حتى لو كان خطأً — يُصحَّح بقيد عكسي جديد
// (reverseEntry) يشير إليه عبر reversalOfId، فيبقى كِلا القيدين ظاهرَين
// للتدقيق الكامل (هذا هو معنى "دفتر أستاذ" حقيقي، لا مجرّد جدول قابل للتعديل).
model JournalEntry {
  id           String   @id @default(uuid())
  entryDate    DateTime @default(now())
  description  String
  sourceType   String? // 'Expense' | 'TreasuryMovement' | 'ClientBalanceMovement' | 'Remittance' | 'Manual' ...
  sourceId     String? // معرّف السجل المصدر إن كان القيد مُرحَّلًا تلقائيًا من وحدة أخرى
  reversalOfId String? // إن كان هذا القيد عكسيًا يُلغي أثر قيد سابق بعينه
  postedById   String
  postedBy     User     @relation(fields: [postedById], references: [id])
  createdAt    DateTime @default(now())

  lines JournalLine[]

  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

// سطر قيد — دومًا أحد الحقلين (debit/credit) موجب والآخر صفر، أبدًا كلاهما
// معًا. currencyId إلزامي لأن كل حساب هنا "حساب تحكّم" متعدد العملات (تمييز
// الأرصدة الفعلي بالعملة يتم بالتجميع وقت القراءة، لا بتعدد صفوف الحساب).
model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  currencyId     String
  currency       Currency     @relation(fields: [currencyId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  memo           String?

  @@index([accountId, currencyId])
  @@map("journal_lines")
}
