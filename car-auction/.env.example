# ---- الخادم
PORT=4000
NODE_ENV=development

# ---- قاعدة البيانات (PostgreSQL 14+)
DATABASE_URL="postgresql://auction:auction@localhost:5432/car_auction"
DB_POOL_MAX=20

# ---- مفاتيح التشفير (إلزامية في الإنتاج). ولّدها بـ: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""
LOOKUP_HMAC_KEY=""
SESSION_TTL_HOURS=10
COOKIE_SECURE=false

# ---- التكامل الخارجي (اتركها فارغة مع MOCK_FEEDS=true لاستخدام المحاكي)
MOCK_FEEDS=true
MOCK_FAULT_RATE=0.15
SCHEDULER_ENABLED=true
COPART_FEED_URL=""
COPART_API_TOKEN=""
IAAI_FEED_URL=""
IAAI_API_TOKEN=""
TRACKING_API_URL=""
TRACKING_API_TOKEN=""
