# خادم التطبيق
PORT=3000
NODE_ENV=development

# قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://exlibya:exlibya@localhost:5432/exlibya?schema=public"

# المصادقة (JWT)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# محرك أسعار الصرف — الحد الأقصى المسموح به لانحراف السعر عن آخر سعر منشور
# قبل أن يرفضه قاطع الدائرة تلقائيًا (كنسبة مئوية)
FX_MAX_DEVIATION_PERCENT=8

# الحد الأدنى لمبلغ الصفقة (بما يعادله بالدولار) الذي يستوجب موافقة مزدوجة
DUAL_APPROVAL_THRESHOLD_USD=30000

# نسبة الاستخدام من حدود العميل التي تُرسل عندها تنبيه اقتراب عبر واتساب
LIMIT_ALERT_THRESHOLD_PERCENT=80

# واتساب — WhatsApp Business Cloud API (اتركها فارغة محليًا: تعمل المنظومة
# عندئذٍ بموفّر وهمي (NullWhatsAppProvider) يسجّل الرسائل دون إرسالها فعليًا)
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN="change-me-verify-token"
WHATSAPP_APP_SECRET=
# نسبة انحراف السعر التي تستوجب بثّ تحديث جماعي تلقائي للمشتركين
WHATSAPP_BROADCAST_DEVIATION_PERCENT=2
