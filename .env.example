# خادم التطبيق
PORT=3000
NODE_ENV=development

# قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://exlibya:exlibya@localhost:5432/exlibya?schema=public"

# المصادقة (JWT)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# محرك أسعار الصرف — الحد الأقصى المسموح به لانحراف السعر عن آخر سعر منشور
# قبل أن يرفضه قاطع الدائرة تلقائيًا (كنسبة مئوية)
FX_MAX_DEVIATION_PERCENT=8

# الحد الأدنى لمبلغ الصفقة (بما يعادله بالدولار) الذي يستوجب موافقة مزدوجة
DUAL_APPROVAL_THRESHOLD_USD=30000
